# Copy to .env and edit. Never commit .env.
# docker compose reads .env automatically from this directory.

# ---- Option A: OpenAI ----
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# ---- Option B: fully local, no key, no egress ----
# Any OpenAI-compatible server works — the model DDL only speaks that wire format.
# Run Ollama on the host and point the containers at it:
#   ollama pull qwen2.5:3b-instruct
# OPENAI_API_KEY=ollama
# OPENAI_BASE=http://host.docker.internal:11434/v1
# CHAT_MODEL=qwen2.5:3b-instruct
